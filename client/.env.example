# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=scaleflow-aee7f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scaleflow-aee7f
VITE_FIREBASE_STORAGE_BUCKET=scaleflow-aee7f.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
# Base de datos Firestore con nombre (Scaleflow Suite usa "suite")
VITE_FIREBASE_DATABASE_ID=suite

# Empresa ID (ID de la empresa en Firestore - Expo Empresarios de la Baja)
# Si no se configura, se usará el ID por defecto: sTQMprSt6gM7htOXKCKwWnr5n3A2
VITE_EMPRESA_ID=sTQMprSt6gM7htOXKCKwWnr5n3A2

# Email API (Cloud Function del proyecto Suite)
VITE_EMAIL_API_URL=https://us-central1-scaleflow-aee7f.cloudfunctions.net/emailAPI/sendEmail
